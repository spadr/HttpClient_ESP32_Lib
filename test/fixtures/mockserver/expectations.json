[
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/test"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "message": "Hello from MockServer",
        "timestamp": "2024-01-01T00:00:00Z",
        "status": "success"
      }
    }
  },
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/users",
      "headers": {
        "Content-Type": ["application/json"]
      }
    },
    "httpResponse": {
      "statusCode": 201,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "id": 123,
        "status": "created",
        "message": "User created successfully"
      }
    }
  },
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/auth",
      "headers": {
        "Authorization": ["Bearer valid-token"]
      }
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "status": "authenticated",
        "user": "test@example.com",
        "permissions": ["read", "write"]
      }
    }
  },
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/auth"
    },
    "httpResponse": {
      "statusCode": 401,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "error": "Unauthorized",
        "message": "Valid Bearer token required"
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/timeout"
    },
    "httpResponse": {
      "statusCode": 200,
      "delay": {
        "timeUnit": "SECONDS",
        "value": 5
      },
      "body": {
        "message": "Delayed response",
        "delay": "5 seconds"
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/large"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["text/plain"]
      },
      "body": "${'x' * 10240}"
    }
  },
  {
    "httpRequest": {
      "method": "POST",
      "path": "/api/upload"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "message": "Upload successful",
        "received": "multipart/form-data"
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/notfound"
    },
    "httpResponse": {
      "statusCode": 404,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "error": "Not Found",
        "message": "The requested resource was not found"
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/error"
    },
    "httpResponse": {
      "statusCode": 500,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "error": "Internal Server Error",
        "message": "Something went wrong on the server"
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/redirect"
    },
    "httpResponse": {
      "statusCode": 302,
      "headers": {
        "Location": ["http://localhost:1080/api/final"]
      }
    }
  },
  {
    "httpRequest": {
      "method": "GET",
      "path": "/api/final"
    },
    "httpResponse": {
      "statusCode": 200,
      "headers": {
        "Content-Type": ["application/json"]
      },
      "body": {
        "message": "Final destination reached",
        "redirected": true
      }
    }
  }
